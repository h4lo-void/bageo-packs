        "style": "casual"
      },
      {
        "text": "കുറച്ചു ഉറക്കെ പറയാമോ?",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "The -ആമോ? ending makes a soft request; names are often spelled in English letters over the phone.",
    "examples": [
      {
        "text": "ഒന്നുകൂടി പറയാമോ?",
