  "cant_hear": {
    "direction": "Say the voice is unclear; Keralites commonly mention റേഞ്ച് or the call cutting (കട്ട് ആകുന്നു).",
    "examples": [
      {
        "text": "ശബ്ദം വ്യക്തമല്ല.",
