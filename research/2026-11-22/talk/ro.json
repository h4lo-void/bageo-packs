{
  "lang": "ro",
  "backchannels": {
    "direction": "Da and aha show listening; sigur and înțeleg agree; da, da, da said fast sounds impatient.",
    "examples": [
      {
        "text": "Aha, deci așa.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Da, vă ascult.",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "Sigur.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Înțeleg.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Da, da, da.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
