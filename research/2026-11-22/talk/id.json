        "style": "polite"
      },
      {
        "text": "Siapa nih?",
        "style": "casual"
      }
    ]
  },
  "wrong_number": {
    "direction": "Say salah sambung and nobody of that name lives here; short.",
    "examples": [
      {
        "text": "Maaf, sepertinya salah sambung.",
        "style": "polite"
      },
      {
        "text": "Di sini tidak ada yang namanya itu.",
