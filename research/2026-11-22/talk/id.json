  },
  "relay": {
    "direction": "Saya sampaikan tells them {owner} hears of it; give no hour for a reply.",
    "examples": [
      {
        "text": "Pesannya nanti saya sampaikan ke {owner}.",
        "style": "polite"
      },
      {
        "text": "Oke, nanti saya kabari.",
