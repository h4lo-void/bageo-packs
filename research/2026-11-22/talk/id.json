{
  "lang": "id",
  "backchannels": {
    "direction": "Iya and he'eh show listening; oh gitu acknowledges news; iya iya iya said fast can sound impatient.",
    "examples": [
      {
        "text": "Iya, Pak.",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "He'eh.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Oh, gitu.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Betul sekali, Bu.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Iya iya iya.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
    "direction": "Masa? or Oh ya? for surprise; turut prihatin / turut berduka for sympathy; selamat ya for good news.",
    "examples": [
      {
        "text": "Masa sih?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "Oh ya? Serius?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "Saya turut prihatin.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Wah, selamat ya!",
        "style": "casual",
        "function": "joy"
      },
      {
        "text": "Agak repot juga itu.",
        "style": "casual",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
    "direction": "Say the signal is bad (sinyalnya jelek) or the voice breaks (putus-putus), then request lebih keras.",
    "examples": [
      {
        "text": "Maaf, suaranya kurang jelas.",
        "style": "polite"
      },
      {
        "text": "Sinyalnya jelek di sini.",
        "style": "casual"
      },
      {
        "text": "Suara Bapak putus-putus.",
        "style": "polite"
      },
      {
        "text": "Bisa lebih keras sedikit, Bu?",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "Gimana? or Maaf, bagaimana? asks for a replay; ask names to be dieja; echo the nomor.",
    "examples": [
      {
        "text": "Maaf, bagaimana tadi?",
        "style": "polite"
      },
      {
        "text": "Gimana?",
        "style": "casual"
      },
      {
        "text": "Namanya dieja bagaimana, Pak?",
        "style": "polite"
      },
      {
        "text": "Nomornya 12345678, betul?",
        "style": "polite"
      }
    ]
  },
  "who_is_calling": {
    "direction": "Dengan siapa saya bicara? or Ini dari mana ya? is polite; Siapa nih? is casual.",
    "examples": [
      {
        "text": "Maaf, dengan siapa saya bicara?",
        "style": "polite"
      },
      {
        "text": "Ini dari mana ya, Pak?",
        "style": "polite"
      },
      {
