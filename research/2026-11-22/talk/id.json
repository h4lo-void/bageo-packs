      },
      {
        "text": "Akan saya teruskan, Bu.",
        "style": "polite"
      }
    ]
  },
  "sales_decline": {
    "direction": "Thank them (makasih) then tidak tertarik; Indonesians prefer a soft maaf before a no.",
    "examples": [
      {
        "text": "Maaf, Pak, saya tidak tertarik.",
        "style": "polite"
      },
      {
        "text": "Terima kasih, kami belum perlu.",
        "style": "polite"
      },
      {
        "text": "Nggak dulu deh, makasih.",
        "style": "casual"
      }
    ]
  },
  "firm_no": {
    "direction": "If they keep pushing, cite the earlier refusal and ask them to hapus nomor ini from their data.",
    "examples": [
      {
        "text": "Tadi sudah saya bilang, tidak tertarik.",
        "style": "polite"
      },
      {
        "text": "Tolong jangan telepon nomor ini lagi.",
        "style": "polite"
      },
      {
        "text": "Mohon hapus nomor ini dari data Anda.",
        "style": "polite"
      }
    ]
  },
  "address_forms": {
