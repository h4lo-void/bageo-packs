{
  "lang": "fi",
  "backchannels": {
    "direction": "VISK treats joo as the high-frequency particle; niin can agree or continue, and mm is a quieter, sparser sound.",
    "examples": [
      {
        "text": "Joo.",
        "style": "casual",
        "function": "agreement"
      },
      {
        "text": "Niin.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "mm",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Aivan.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Just.",
        "style": "casual",
        "function": "agreement"
      },
      {
        "text": "Selvä.",
        "style": "casual",
        "function": "agreement"
      },
      {
        "text": "Joo joo.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
    "direction": "Ihanko totta? and Oikeasti? take surprise; Ikävä kuulla is everyday sympathy, short and fairly plain.",
