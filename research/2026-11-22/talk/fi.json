      },
      {
        "text": "Tyytyväisyytesi on etusijalla.",
        "style": "polite"
      },
      {
        "text": "Voinko auttaa vielä jossain?",
        "style": "polite"
      }
    ]
  },
  "taboo_on_phone": {
    "direction": "Stiff te with an ordinary caller, a late ring, or asking for a henkilötunnus at the start all feel out of place.",
    "examples": [
      {
        "text": "Oletko naimisissa? Paljonko tienaat?",
        "style": "casual"
      },
      {
        "text": "Kuka sinä olet? Sano heti.",
        "style": "casual"
      },
      {
        "text": "Anna ensin osoitteesi ja henkilötunnuksesi.",
        "style": "polite"
      },
      {
        "text": "Nauhoitan tätä puhelua jo.",
        "style": "casual"
      }
    ]
  },
