  "avoid_service_phrases": {
    "direction": "Puhelusi on meille tärkeä and Kuinka voin auttaa tänään belong in a call-centre script, not on a private puhelin.",
    "examples": [
      {
        "text": "Puhelusi on meille tärkeä.",
        "style": "polite"
      },
      {
        "text": "Kuinka voin auttaa tänään?",
