      {
        "text": "Ihanko totta?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "Oikeasti?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "Ikävä kuulla.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Voi ei.",
        "style": "casual",
        "function": "sympathy"
      },
      {
        "text": "Ihanaa!",
        "style": "casual",
        "function": "joy"
      },
      {
        "text": "Onneksi olkoon.",
        "style": "polite",
        "function": "joy"
      },
