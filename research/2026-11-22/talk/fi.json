      {
        "text": "Älkää soittako enää.",
        "style": "casual"
      },
      {
        "text": "Tämä on lopullinen ei. Älkää ottako enää yhteyttä.",
        "style": "polite"
      }
    ]
  },
  "address_forms": {
    "direction": "sinä plus a first name is the modern default; te is uncommon. herra and rouva appear mainly in official calls.",
    "examples": [
