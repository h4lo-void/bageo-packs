      {
        "text": "Ne mondja!",
        "style": "polite",
        "function": "surprise"
      },
      {
        "text": "Nagyon sajnálom.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Gratulálok!",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "Ez kicsit nehéz lesz.",
        "style": "polite",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
