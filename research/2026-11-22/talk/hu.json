      },
      {
        "text": "Recseg a telefon.",
        "style": "casual"
      },
      {
        "text": "Tudna kicsit hangosabban beszélni?",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "Tessék? or Hogy mondta? asks for a replay; ask names betűzve; echo the szám.",
