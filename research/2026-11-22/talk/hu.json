{
  "lang": "hu",
  "backchannels": {
    "direction": "Igen and aha show listening; persze and értem agree; jó, jó, jó said fast sounds dismissive.",
    "examples": [
      {
        "text": "Aha, igen.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Értem.",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "Persze.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Így van.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "Jó, jó, jó.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
