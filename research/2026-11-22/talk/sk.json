      }
    ]
  },
  "relay": {
    "direction": "Vyriadim and Odovzdám odkaz {owner} pass the news along in Slovak; they do not, alone, set an hour to ring back.",
    "examples": [
      {
        "text": "Vyriadim.",
        "style": "polite"
      },
      {
        "text": "Vyriadim to {owner}.",
        "style": "polite"
      },
