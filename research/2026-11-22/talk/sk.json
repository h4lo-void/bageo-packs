        "style": "polite"
      },
      {
        "text": "Poviem jej to.",
        "style": "casual"
      }
    ]
  },
  "sales_decline": {
    "direction": "Nie, ďakujem, nemám záujem is the everyday close; Nemáme záujem is the household variant, still brief.",
