  "cant_hear": {
    "direction": "Zle vás počujem and Zlé spojenie name the line; Stále to vypadáva describes a call that keeps dropping.",
    "examples": [
      {
        "text": "Zle vás počujem.",
        "style": "polite"
      },
      {
        "text": "Zlé spojenie.",
        "style": "casual"
      },
      {
        "text": "Stále to vypadáva.",
