      },
      {
        "text": "To je naozaj škoda.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Je mi to ľúto.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Paráda!",
        "style": "casual",
        "function": "joy"
      },
      {
        "text": "Gratulujem.",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "To bude ťažké.",
        "style": "polite",
        "function": "difficulty"
      }
    ]
