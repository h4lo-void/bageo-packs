      },
      {
        "text": "Môžete hovoriť trochu hlasnejšie?",
        "style": "polite"
      },
      {
        "text": "Koniec som nepočul.",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "Môžete to zopakovať, prosím is the careful replay; vyhláskovať covers a name, and a number is said ešte raz.",
    "examples": [
      {
        "text": "Môžete to zopakovať, prosím?",
        "style": "polite"
      },
      {
        "text": "Čože? Nerozumiem.",
        "style": "casual"
      },
      {
        "text": "Môžete to meno vyhláskovať?",
        "style": "polite"
      },
      {
        "text": "Povedzte číslo ešte raz. Je to 12345678?",
        "style": "polite"
      }
    ]
  },
  "who_is_calling": {
    "direction": "Kto volá, prosím and S kým hovorím are the usual probes; name the handset if it belongs to {owner}.",
    "examples": [
      {
        "text": "Kto volá, prosím?",
        "style": "polite"
      },
      {
        "text": "S kým hovorím?",
        "style": "polite"
      },
      {
        "text": "Tu je telefón {owner}. Kto volá?",
        "style": "polite"
      },
      {
        "text": "Kto je to?",
        "style": "casual"
      }
    ]
  },
  "wrong_number": {
    "direction": "Zlé číslo and Pomýlili ste sa číslom close the matter; Tu nikto taký nebýva covers a mismatched name.",
