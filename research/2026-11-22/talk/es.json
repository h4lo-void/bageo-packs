        "text": "¿En serio?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "¿De verdad?",
        "style": "polite",
        "function": "surprise"
      },
      {
        "text": "Ay, qué pena.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "Lo siento mucho.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "¡Qué bien!",
        "style": "casual",
        "function": "joy"
      },
      {
        "text": "Felicidades.",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "Eso va a estar difícil.",
        "style": "polite",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
    "direction": "No le oigo bien is the careful complaint; Se corta la llamada and mala cobertura describe a dropping mobile link.",
