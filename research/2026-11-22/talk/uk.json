      {
        "text": "Хто це?",
        "style": "casual"
      },
      {
        "text": "Представтеся, будь ласка.",
        "style": "polite"
      }
    ]
  },
  "wrong_number": {
    "direction": "Ви помилилися номером is the standard close; Неправильний номер is blunter. The household is not usually explained.",
