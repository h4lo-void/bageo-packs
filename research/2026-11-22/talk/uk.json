  "who_is_calling": {
    "direction": "Хто говорить and З ким я розмовляю are the usual probes; Представтеся is stiffer. Say if the phone is {owner}'s.",
    "examples": [
      {
        "text": "Хто говорить?",
        "style": "polite"
      },
      {
        "text": "З ким я розмовляю?",
        "style": "polite"
      },
