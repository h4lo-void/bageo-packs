  "cant_hear": {
    "direction": "Я вас погано чую and Поганий зв'язок are the ordinary complaints; Вас обриває names a dropping link.",
    "examples": [
      {
        "text": "Я вас погано чую.",
        "style": "polite"
      },
      {
        "text": "Поганий зв'язок.",
        "style": "casual"
      },
      {
        "text": "Вас обриває.",
