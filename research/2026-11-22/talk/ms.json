        "style": "casual"
      },
      {
        "text": "Kak",
        "style": "casual"
      }
    ]
  },
  "avoid_service_phrases": {
    "direction": "Lines like Panggilan anda amat penting bagi kami sound like a khidmat pelanggan hotline.",
    "examples": [
      {
        "text": "Panggilan anda amat penting bagi kami.",
        "style": "polite"
      },
      {
        "text": "Terima kasih kerana menghubungi khidmat pelanggan.",
        "style": "polite"
      },
      {
        "text": "Apa yang boleh saya bantu hari ini?",
        "style": "polite"
      }
    ]
  },
  "taboo_on_phone": {
    "direction": "Using kau/engkau with elders, or asking race, religion or salary early, is rude.",
    "examples": [
