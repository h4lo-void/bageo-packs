{
  "lang": "ta",
  "backchannels": {
    "direction": "The -ங்க ending adds respect: ஆமாங்க, சரிங்க; bare ம்ம் is casual; repeated சரி சரி may sound dismissive.",
    "examples": [
      {
        "text": "ஆமாங்க.",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "சரிங்க.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "ம்ம்.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "அப்படியா.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "சரி சரி.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
    "direction": "அப்படியா? for surprise; ஐயோ for dismay; ரொம்ப சந்தோஷம் for good news.",
    "examples": [
      {
        "text": "அப்படியாங்க?",
        "style": "polite",
        "function": "surprise"
      },
      {
        "text": "நிஜமாவா?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "ஐயோ, பாவம்.",
        "style": "casual",
        "function": "sympathy"
      },
      {
        "text": "கேட்கவே வருத்தமா இருக்குங்க.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "ரொம்ப சந்தோஷம்!",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "கொஞ்சம் கஷ்டம்தாங்க.",
        "style": "polite",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
    "direction": "Say the voice isn't coming through (கேக்கலை) or the signal is poor, then request சத்தமா speech.",
    "examples": [
      {
        "text": "சரியா கேக்கலைங்க.",
        "style": "polite"
      },
      {
        "text": "சிக்னல் சரியில்லை.",
        "style": "casual"
      },
      {
        "text": "குரல் கட் ஆகுதுங்க.",
        "style": "polite"
      },
      {
        "text": "கொஞ்சம் சத்தமா பேசுறீங்களா?",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "என்னங்க? asks for a replay; get name letters one by one; read back a number to confirm.",
    "examples": [
