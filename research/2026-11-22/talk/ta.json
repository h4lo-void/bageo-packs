        "style": "polite"
      },
      {
        "text": "நம்பர் 12345678 தானே?",
        "style": "polite"
      },
      {
        "text": "என்ன?",
        "style": "casual"
      }
    ]
  },
  "who_is_calling": {
    "direction": "யார் பேசறீங்க with -ங்க is polite; யாரு நீ is rude; you can ask where they're calling from.",
    "examples": [
      {
        "text": "யார் பேசறீங்க?",
        "style": "polite"
      },
      {
        "text": "எங்கிருந்து கூப்பிடறீங்க?",
