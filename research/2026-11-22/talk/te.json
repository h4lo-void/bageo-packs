        "style": "polite",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
    "direction": "Mention the weak signal or unclear voice, then ask them to speak louder with -అండి.",
    "examples": [
      {
        "text": "వినిపించట్లేదండి.",
        "style": "polite"
      },
      {
        "text": "సిగ్నల్ సరిగ్గా లేదు.",
        "style": "casual"
      },
      {
