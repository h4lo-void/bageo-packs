{
  "lang": "te",
  "backchannels": {
    "direction": "Add -అండి for respect: అవునండి, సరేనండి; bare ఆ or ఊ is casual; repeated సరే సరే can sound like brushing off.",
    "examples": [
      {
        "text": "అవునండి.",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "సరేనండి.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "ఆ.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "ఊ.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "సరే సరే.",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
