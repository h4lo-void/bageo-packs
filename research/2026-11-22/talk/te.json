      {
        "text": "ఏమన్నారండి?",
        "style": "polite"
      },
      {
        "text": "మళ్ళీ ఒకసారి చెప్తారా?",
        "style": "polite"
      },
      {
        "text": "మీ పేరు స్పెల్లింగ్ చెప్తారా?",
        "style": "polite"
      },
      {
        "text": "నంబర్ 12345678 కదండి?",
        "style": "polite"
      },
      {
        "text": "ఏంటి?",
        "style": "casual"
      }
    ]
  },
  "who_is_calling": {
    "direction": "Ask ఎవరు మాట్లాడుతున్నారండి with మీరు; plain ఎవరు? to a stranger sounds curt.",
    "examples": [
      {
        "text": "ఎవరు మాట్లాడుతున్నారండి?",
        "style": "polite"
      },
      {
        "text": "ఎక్కడి నుంచి కాల్ చేస్తున్నారు?",
        "style": "polite"
      },
      {
        "text": "ఇది {owner} గారి నంబర్, మీరెవరండి?",
        "style": "polite"
      }
    ]
  },
  "wrong_number": {
    "direction": "Tell them రాంగ్ నంబర్ and that no such person lives here, briefly and with -అండి.",
    "examples": [
      {
        "text": "రాంగ్ నంబర్ అండి.",
        "style": "polite"
      },
      {
        "text": "ఇక్కడ ఆ పేరుతో ఎవరూ లేరండి.",
