      },
      {
        "text": "{owner}nin ofisinə zəng etdiyiniz üçün təşəkkür edirik.",
        "style": "polite"
      }
    ]
  },
  "taboo_on_phone": {
    "direction": "Switching to sən too soon, or asking for a fin or salary at the start, feels like overstepping.",
