  "who_is_calling": {
    "direction": "من معي؟ is the everyday probe; formal من المتحدث؟ fits strangers. On a shared phone, name {owner} first.",
    "examples": [
      {
        "text": "من معي؟",
        "style": "casual"
      },
      {
        "text": "من المتحدث، من فضلك؟",
