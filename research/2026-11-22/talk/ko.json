        "text": "응.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "어.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "네.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "예.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "맞아요.",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "그래요.",
        "style": "polite",
        "function": "agreement"
      },
