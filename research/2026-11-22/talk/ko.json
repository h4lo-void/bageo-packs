  "reactions": {
    "direction": "정말요 is the polite surprise; 헐 is intimate. 안타깝네요 carries sympathy; 잘 됐네요 and 축하해요 mark good news.",
    "examples": [
      {
        "text": "정말요?",
        "style": "polite",
        "function": "surprise"
      },
      {
        "text": "헐, 진짜?",
        "style": "casual",
        "function": "surprise"
      },
      {
        "text": "아이고, 안타깝네요.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "마음이 힘드시겠어요.",
        "style": "polite",
        "function": "sympathy"
      },
      {
        "text": "잘 됐네요!",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "축하해요.",
        "style": "polite",
        "function": "joy"
      },
      {
        "text": "그건 좀 어려울 것 같아요.",
        "style": "polite",
        "function": "difficulty"
      }
    ]
  },
  "cant_hear": {
    "direction": "잘 안 들려요 and 통화 상태가 안 좋아요 are ordinary mobile complaints; 목소리가 끊기네요 names a dropping link.",
