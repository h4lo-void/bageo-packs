  "cant_hear": {
    "direction": "Źle pana or panią słyszę is the careful complaint; Słaba łączność names a poor mobile link.",
    "examples": [
      {
        "text": "Źle pana słyszę.",
        "style": "polite"
      },
      {
        "text": "Źle panią słyszę.",
        "style": "polite"
      },
      {
        "text": "Słaba łączność.",
        "style": "casual"
      },
      {
        "text": "Może pan mówić trochę głośniej?",
        "style": "polite"
      },
      {
        "text": "Nie dosłyszałem końca.",
        "style": "polite"
      }
    ]
  },
  "ask_repeat": {
    "direction": "Czy może pan powtórzyć, proszę is the careful replay; przeliterować covers a name, and a number is said still once more.",
    "examples": [
      {
        "text": "Czy może pan powtórzyć, proszę?",
        "style": "polite"
      },
      {
        "text": "Co? Nie zrozumiałem.",
        "style": "casual"
      },
      {
        "text": "Czy może pan przeliterować nazwisko?",
        "style": "polite"
      },
      {
        "text": "Proszę powtórzyć numer. Czy to 12345678?",
        "style": "polite"
      },
      {
        "text": "Co pan powiedział?",
        "style": "polite"
      }
    ]
  },
  "who_is_calling": {
    "direction": "Kto mówi, proszę and Z kim rozmawiam are the usual probes; Może się pan przedstawić is stiffer. Name {owner}'s phone.",
    "examples": [
      {
        "text": "Kto mówi, proszę?",
        "style": "polite"
      },
      {
        "text": "Z kim rozmawiam?",
        "style": "polite"
      },
      {
        "text": "To telefon {owner}. Kto dzwoni?",
        "style": "polite"
      },
      {
        "text": "Kto to?",
        "style": "casual"
      },
      {
        "text": "Może się pan przedstawić?",
        "style": "polite"
      }
    ]
  },
  "wrong_number": {
    "direction": "Pomyłka and Źle się pan połączył close the matter; Nie ma tu nikogo o tym nazwisku covers a mismatched name.",
    "examples": [
      {
        "text": "Przepraszam, pomyłka.",
        "style": "polite"
      },
      {
        "text": "Źle się pan połączył.",
        "style": "polite"
      },
      {
        "text": "Nie ma tu nikogo o tym nazwisku.",
        "style": "polite"
      },
      {
        "text": "Zły numer.",
        "style": "casual"
      }
    ]
  },
  "relay": {
    "direction": "Przekażę and Przekażę wiadomość {owner} pass the news along; they do not, alone, set an hour to ring back.",
