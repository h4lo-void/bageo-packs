      {
        "text": "Mhm, tak.",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "Tak.",
        "style": "casual",
        "function": "agreement"
      },
      {
        "text": "aha",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "No.",
        "style": "casual",
        "function": "listening"
      },
      {
