{
  "lang": "ne",
  "backchannels": {
    "direction": "हजुर and हो show respectful listening; अँ and ल are casual; repeated ल ल can sound like brushing off.",
    "examples": [
      {
        "text": "हजुर।",
        "style": "polite",
        "function": "listening"
      },
      {
        "text": "हो, हो।",
        "style": "polite",
        "function": "agreement"
      },
      {
        "text": "अँ।",
        "style": "casual",
        "function": "listening"
      },
      {
        "text": "ठिक छ।",
        "style": "casual",
        "function": "agreement"
      },
      {
        "text": "ल ल।",
        "style": "casual",
        "function": "dismissive"
      }
    ]
  },
  "reactions": {
    "direction": "हो र? for surprise; कस्तो दुःखको कुरा for sympathy; बधाई छ for good news.",
